{
  "description": "Continue unfinished FM-Agent runs through the native Claude CLI without direct model API calls.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/continuation_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
